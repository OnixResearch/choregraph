{
  source_format = "choregraph-v1",
  schema = "choregraph.evaluated-graph.v1",
  lifecycle_profile = "choregraph.lifecycle.durable-suspension.v2",
  events = ["cancel", "complete", "fail", "mark-ready", "resume-signal", "start", "suspend"],
  limits = {
    max_nodes = 4,
    max_edges = 4,
    max_operations = 4,
